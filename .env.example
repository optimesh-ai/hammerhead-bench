# Copy to .env and edit, then load it into your shell before running:
#
#   set -a; . ./.env; set +a
#
# The harness reads the shell environment only; it does not parse this file.
#
# Required:
# Path to the Hammerhead CLI. The harness invokes this as a black box:
#   $HAMMERHEAD_CLI simulate <configs_dir> --emit-rib all --format json
#
# Hammerhead v0.2.0+ release builds need a licence. Either run
# `hammerhead license install <token>` once, or set it here:
# HAMMERHEAD_LICENSE=<token>
# Request access at https://optimesh.ai/#trial.
#
# The default below is a fake script that returns a perturbed copy of the
# vendor truth FIB, so the pipeline can be exercised without Hammerhead.
HAMMERHEAD_CLI=./scripts/fake_hammerhead.sh

# Optional overrides. The harness honours only these:
#
# Batfish image. Default: the digest pinned in versions.lock.
# BATFISH_IMAGE=batfish/allinone@sha256:...
#
# cEOS-lab tag you imported. Default: ceos:4.32.0F.
# CEOS_IMAGE=ceos:4.32.0F
#
# Turn off the best-effort peak-RSS samplers.
# HAMMERHEAD_BENCH_DISABLE_PEAK_RSS=1
#
# The FRR image is the adapter default (frrouting/frr:v8.4.1, as in
# versions.lock). To skip large topologies, pass --max-nodes N to
# `hammerhead-bench bench`, or use `make bench-fast`.
